# Chatbot Backend Configuration
PORT=8000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# MongoDB Atlas Configuration (must point to the same Atlas cluster used by backend/MONGO_URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=expenseDB

# JWT Authentication (matches existing backend)
JWT_SECRET=local-dev-secret-change-before-production
JWT_ALGORITHM=HS256

# OpenAI API Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Vector Database
CHROMA_DB_PATH=./chroma_db
